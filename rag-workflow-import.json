        "jsCode": "const body = $json.body ?? $json;\nconst name = String(body.name || '').trim();\nif (name.length < 1 || name.length > 100) throw new Error('name (1-100 chars) is required');\nconst sources = Array.isArray(body.sources) ? body.sources.map(String) : [];\nif (sources.length === 0) throw new Error('Select at least one source');\nconst out = { name, sources, description: body.description ? String(body.description).slice(0, 500) : '' };\nreturn [{ json: out }];"
