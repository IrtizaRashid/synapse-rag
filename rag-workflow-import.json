    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst question = String(body.question || '').trim();\nif (question.length < 2) throw new Error('question is required');\nconst out = { question, top_k: Math.max(1, Math.min(Number(body.top_k || 5), 20)) };\nconst chatbot_id = body.chatbot_id ? String(body.chatbot_id).trim() : '';\nconst sources = Array.isArray(body.sources) ? body.sources.map(String) : [];\nif (!chatbot_id && sources.length === 0) throw new Error('Provide chatbot_id or at least one source');\nif (chatbot_id) out.chatbot_id = chatbot_id;\nif (sources.length) out.sources = sources;\nreturn [{ json: out }];"
      },
