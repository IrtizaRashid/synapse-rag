# ---- Gemini (optional; without a key the app returns retrieved passages) ----
GEMINI_API_KEY=
# Optional comma-separated rotation pool. If set, Gemini requests are spread
# across these keys; GEMINI_API_KEY remains a backward-compatible fallback.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash

# ---- RAG ----
MAX_UPLOAD_MB=25
MAX_FILES_PER_USER=200
MAX_STORAGE_MB=1024
TOP_K=5
INDEX_WORKERS=2
# "vector" -> pgvector on Supabase (needs GEMINI_API_KEY + Supabase + rag_vector.sql)
# "local"  -> TF-IDF on JSON file (zero-config fallback)
RAG_BACKEND=vector
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
# Use local to avoid failed uploads when Gemini embeddings are unavailable.
EMBEDDING_PROVIDER=gemini
# Keep false in production so vector spaces are not mixed after a provider outage.
EMBEDDING_LOCAL_FALLBACK=false

# ---- Security ----
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=10
ASK_RATE_LIMIT=20
INGEST_RATE_LIMIT=10
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
# Comma-separated extra origins allowed by the CSRF check, e.g. http://127.0.0.1:3000,https://rag.yourdomain.com
ALLOWED_ORIGINS=
# Comma-separated hostnames for TrustedHostMiddleware, e.g. rag.yourdomain.com
ALLOWED_HOSTS=
# Optional: redirect FastAPI page routes to the Next.js frontend.
FRONTEND_ORIGIN=http://127.0.0.1:3000
# Set true when behind a reverse proxy so X-Forwarded-For is trusted
TRUST_PROXY=false
# Comma-separated keys that let headless clients (n8n) call the RAG API via X-API-Key.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_API_KEYS=
# Single key passed to n8n (must be one of the values in RAG_API_KEYS)
RAG_API_KEY=
# Long random key used by n8n to encrypt credentials at rest.
N8N_ENCRYPTION_KEY=

# ---- Chatbots ----
# "supabase" (default when Supabase keys set) or "local" (JSON file fallback)
CHATBOT_BACKEND=
CHATBOT_DB_PATH=data/chatbots.json

# ---- Auth backend ----
# "local"    -> SQLite at data/auth.db (zero-config, good for testing)
# "supabase" -> Postgres via Supabase REST (requires keys below + schema.sql)
AUTH_BACKEND=local
OTP_LENGTH=6
OTP_TTL_SECONDS=600
MAX_OTP_ATTEMPTS=3
OTP_LOCK_SECONDS=600
OTP_RESEND_COOLDOWN=60
SESSION_TTL_DAYS=7
# Set to true when serving over HTTPS.
COOKIE_SECURE=false
# Local development only. When true, OTPs are returned by the API if email is unavailable.
ALLOW_DEV_OTP=false

# ---- Supabase (required when AUTH_BACKEND=supabase) ----
# Project settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed to run supabase/schema.sql + rag_vector.sql from CLI:
# Project settings -> Database -> Connection string (Session pooler)
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# ---- Email: Resend preferred (https://resend.com), SMTP fallback ----
RESEND_API_KEY=
MAIL_FROM=OCR RAG Platform <onboarding@resend.dev>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
APP_NAME=OCR RAG Platform

# ---- Logging ----
LOG_LEVEL=INFO
# "json" for production logs, "text" for local debugging
LOG_FORMAT=json

# ---- Production authentication ----
APP_NAME=Synapse
APP_URL=http://127.0.0.1:8000
AUTH_SECRET=replace-with-a-long-random-secret
OTP_PEPPER=replace-with-a-long-random-secret
RESET_TOKEN_PEPPER=replace-with-a-long-random-secret
PASSWORD_MIN_LENGTH=12
OTP_TTL_SECONDS=180
MAX_OTP_ATTEMPTS=3
OTP_RESEND_COOLDOWN=60
RESET_TOKEN_TTL_SECONDS=600
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=Synapse <onboarding@resend.dev>
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:8000
DATABASE_URL=
